# Pi SSH target — fill in your Pi's address, do not commit
.pi_host

# Run data saved from the Pi after each run — kept locally only
runs/*
!runs/.gitkeep

# Local Claude Code settings (machine-specific paths, e.g. venv on Pi)
.claude/settings.local.json

# Runtime artefacts
__pycache__/
*.pyc
*.pyo
hailort*.log

# Hailo compilation workspace
/usr/share/hailo-models/_compile_tmp/
